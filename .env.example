# Демо-доступ в панель. Для защиты поменяйте пароль.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=admin123
SESSION_HOURS=12
COOKIE_SECURE=false

# Время снимка. Держите равным data/seed.meta.json -> asOf,
# иначе признаки «дней до продления» поплывут.
AS_OF=2026-10-23T18:00:00.000Z

# Загрузить seed при пустой базе.
SEED_ON_START=true

# Файл необязателен: compose уже содержит рабочие демо-умолчания.
# Создавайте .env, только если хотите их изменить.
#
# OIDC / SSO — необязательно. Пустые значения оставляют только вход по паролю.
# Демо с Keycloak: docker compose -f compose.yaml -f compose.sso.yaml up --build
# (этот оверлей сам задаёт OIDC_* — раскомментировать их для него не нужно)
# OIDC_ISSUER=http://localhost:8081/realms/risk-desk
# OIDC_CLIENT_ID=risk-desk
# OIDC_CLIENT_SECRET=dev-secret-risk-desk
# OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
# OIDC_INTERNAL_BASE=http://keycloak:8080/realms/risk-desk
# OIDC_PROVIDER_NAME=Keycloak

