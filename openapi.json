  "components": {
    "schemas": {
      "AccountIn": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email"
          },
          "balance": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Balance",
            "default": 0
          },
          "withdrawBalance": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Withdrawbalance",
            "default": 0
          },
          "totalReplenished": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Totalreplenished",
            "default": 0
          },
          "bonusBalance": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Bonusbalance",
            "default": 0
          },
          "bonusState": {
            "type": "string",
            "enum": [
              "locked",
              "unlocked"
            ],
            "title": "Bonusstate",
            "default": "locked"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email"
        ],
        "title": "AccountIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn"
      },
      "MoneyPatch": {
        "properties": {
          "balanceMitigation": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Balancemitigation"
          },
          "includeWithdrawBalance": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Includewithdrawbalance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MoneyPatch"
      },
      "ProbabilityPatch": {
        "properties": {
          "midpoint": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Midpoint"
          },
          "steepness": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Steepness"
          },
          "floor": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Floor"
          },
          "ceiling": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ceiling"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ProbabilityPatch"
      },
      "ServiceIn": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Name"
          },
          "ownerId": {
            "type": "integer",
            "title": "Ownerid"
          },
          "paymentTerm": {
            "type": "string",
            "enum": [
              "hour",
              "week",
              "month",
              "quarter_year",
              "half_year",
              "year"
            ],
            "title": "Paymentterm"
          },
          "autoProlong": {
            "type": "boolean",
            "title": "Autoprolong",
            "default": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Expiresat"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "blocked",
              "deleted",
              "suspended",
              "prolong_wait"
            ],
            "title": "Status"
          },
          "price": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Price"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "ownerId",
          "paymentTerm",
          "createdAt",
          "expiresAt",
          "status",
          "price"
        ],
        "title": "ServiceIn"
      },
      "SettingsPatch": {
        "properties": {
          "weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weights"
          },
          "thresholds": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ThresholdsPatch"
              },
              {
                "type": "null"
              }
            ]
          },
          "probability": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProbabilityPatch"
              },
              {
                "type": "null"
              }
            ]
          },
          "money": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoneyPatch"
              },
              {
                "type": "null"
              }
            ]
          },
          "statusFloors": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Statusfloors"
          },
          "recomputeIntervalSec": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3600.0,
                "minimum": 10.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Recomputeintervalsec"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SettingsPatch"
      },
      "SnapshotIn": {
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/AccountIn"
            },
            "type": "array",
            "title": "Accounts"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/ServiceIn"
            },
            "type": "array",
            "title": "Services"
          },
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/TransactionIn"
            },
            "type": "array",
            "title": "Transactions"
          }
        },
        "type": "object",
        "title": "SnapshotIn"
      },
      "ThresholdsPatch": {
        "properties": {
          "medium": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 100.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Medium"
          },
          "high": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 100.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "High"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ThresholdsPatch"
      },
      "TransactionIn": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "amount": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Amount"
          },
          "status": {
            "type": "string",
            "enum": [
              "performed",
              "not_performed"
            ],
            "title": "Status"
          },
          "performedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Performedat"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "type": {
            "type": "string",
            "enum": [
              "prolong",
              "order"
            ],
            "title": "Type"
          },
          "serviceId": {
            "type": "integer",
            "title": "Serviceid"
          }
        },
        "type": "object",
        "required": [
          "id",
          "amount",
          "status",
          "createdAt",
          "type",
          "serviceId"
        ],
        "title": "TransactionIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid"
      }
    }
  }
}
